APP_NAME=PraceAR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Madrid
APP_URL=https://example.invalid
APP_ALLOWED_HOSTS=example.invalid
TRUSTED_PROXIES=

APP_LOCALE=gl
APP_FALLBACK_LOCALE=gl

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DATABASE_URL=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Use at least 32 cryptographically random characters.
PASSWORD_PEPPER_CURRENT=
# JSON array used only during a controlled pepper rotation.
PASSWORD_PEPPER_LEGACY_JSON=[]
PASSWORD_BREACH_CHECK_ENABLED=true

# Only required to create the initial account. Remove the password variable
# from the deployment after bootstrap so a later deploy cannot reset it.
PRACEAR_ADMIN_LOGIN=admin
PRACEAR_ADMIN_PASSWORD=

PRACEAR_ASSETS_PATH=/var/www/html/laravel-docker/public/assets
VIRUSTOTAL_REQUIRED=true
VIRUSTOTAL_API_KEY=
