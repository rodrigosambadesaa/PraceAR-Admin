# Environment and platform metadata
.env
.env.*
!.env.example
!laravel-docker/.env.example
.vercel/

# Secrets, credentials and private keys
/pepper*.php
/**/*_api_key.php
/**/*_app_id.php
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
auth.json

# Database exports and local user uploads
*.sql
/laravel-docker/public/assets/*
!/laravel-docker/public/assets/.gitkeep

# Dependencies and generated assets
node_modules/
vendor/
laravel-docker/vendor/
laravel-docker/node_modules/
public/build/
laravel-docker/public/build/
laravel-docker/public/hot

# Runtime state and caches
laravel-docker/bootstrap/cache/*.php
!laravel-docker/bootstrap/cache/.gitignore
laravel-docker/storage/framework/cache/data/*
laravel-docker/storage/framework/sessions/*
laravel-docker/storage/framework/views/*
laravel-docker/storage/logs/*
.phpunit.cache/
.phpunit.result.cache
tmp_*
*.local.log
*.secrets.json
*.env.backup

# Editor and OS state
.idea/
.vscode/
.fleet/
.nova/
.zed/
Thumbs.db
.DS_Store
